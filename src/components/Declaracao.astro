---
import { site } from '../data/site';

/* REVISÃO: frase adaptada de "Ajudo você a buscar seus direitos com segurança." —
   "com segurança" foi retirado por poder sugerir garantia de resultado. */
---

<section class="section declaracao" aria-label="Apresentação">
  <div class="container">
    <span class="rule-short" aria-hidden="true"></span>
    <p class="declaracao__text">
      Ajudo você a entender e buscar seus direitos previdenciários com informação clara.
    </p>
  </div>
</section>

<style>
  /* Faixa de respiro: mais baixa que as demais seções e centralizada */
  .declaracao {
    padding-block: clamp(3rem, 2rem + 3vw, 4.5rem);
    text-align: center;
  }

  .declaracao .rule-short {
    margin-inline: auto;
  }

  /* Uma linha quando cabe; quando não cabe, quebra em linhas equilibradas */
  .declaracao__text {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1.3rem + 0.8vw, 1.75rem);
    font-style: italic;
    font-weight: 300;
    line-height: 1.4;
    color: var(--text);
    text-wrap: balance;
  }

  .declaracao__by {
    margin-top: var(--space-5);
  }
</style>
