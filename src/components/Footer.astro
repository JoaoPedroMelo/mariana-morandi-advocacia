---
import BrandMark from './BrandMark.astro';
import { site } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="footer on-dark" data-footer>
  <div class="container">
    <div class="footer__cols">
      <div class="footer__id">
        <BrandMark tone="sand" height={56} class="footer__mark" />
        <p class="footer__brand">{site.brand}</p>
        <p>{site.lawyer.title} {site.lawyer.name}</p>
        <p class="eyebrow">{site.oab.label}</p>
      </div>

      <div class="footer__info">
        <p class="eyebrow footer__label">Endereço</p>
        <address>
          {site.address.street}<br />
          {site.address.complement}<br />
          CEP {site.address.postalCode}<br />
          {site.location.label}
        </address>
      </div>

      <div class="footer__info">
        <p class="eyebrow footer__label">Atendimento</p>
        <p>{site.hours}</p>
        <p>{site.modalities}</p>
      </div>
    </div>

    <div class="footer__bottom">
      <div class="footer__legal">
        <p>© {year} {site.brand}. Todos os direitos reservados.</p>
        <p class="footer__credit">
          Desenvolvido por <a href={site.credit.url} target="_blank" rel="noopener noreferrer">
            {site.credit.name}<span class="visually-hidden"> (abre em nova aba)</span>
          </a>
        </p>
      </div>
      <p class="footer__disclaimer">{site.disclaimer}</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding-block: var(--space-8) calc(var(--space-6) + env(safe-area-inset-bottom));
    border-top: var(--line) solid var(--dark-rule);
    font-size: var(--fs-sm);
    line-height: 1.7;
    color: var(--dark-text-muted);
  }

  /* Colunas de mesma largura, com o conteúdo centralizado em cada uma.
     No desktop, nas colunas de informação, o bloco fica no centro e as linhas se
     alinham à esquerda entre si (endereço centralizado linha a linha fica com bordas
     tortas lado a lado com as outras colunas). No mobile, tudo centralizado. */
  .footer__cols {
    display: grid;
    gap: var(--space-7);
    padding-bottom: var(--space-7);
    text-align: center;
  }

  .footer__label {
    margin-bottom: var(--space-4);
  }

  .footer__id :global(.footer__mark) {
    width: auto;
    height: 3.5rem;
    margin: 0 auto var(--space-5);
  }

  .footer__id p + p {
    margin-top: var(--space-1);
  }

  .footer__brand {
    font-family: var(--font-display);
    font-size: var(--fs-md);
    line-height: 1.3;
    color: var(--paper);
  }

  .footer address {
    font-style: normal;
    color: var(--dark-text);
  }

  /* Copyright à esquerda e crédito à direita; abaixo, o aviso sozinho e centralizado */
  .footer__bottom {
    display: grid;
    gap: var(--space-4);
    padding-top: var(--space-5);
    border-top: var(--line) solid var(--dark-rule);
    font-size: var(--fs-xs);
  }

  /* Mobile: centralizado. Desktop: copyright à esquerda, crédito à direita. */
  .footer__legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2) var(--space-6);
    text-align: center;
  }

  .footer__disclaimer {
    text-align: center;
  }

  .footer__credit {
    white-space: nowrap;
  }

  .footer__credit a {
    color: var(--dark-text);
    text-decoration-line: underline;
    text-decoration-color: var(--sand);
    text-underline-offset: 0.22em;
  }

  .footer__credit a:hover {
    color: var(--sand);
  }

  /* Três colunas só quando a do endereço comporta a linha mais longa */
  @media (min-width: 64em) {
    .footer__cols {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-6);
    }

    .footer__info {
      justify-self: center;
      text-align: left;
    }

    .footer__legal {
      justify-content: space-between;
      text-align: left;
    }
  }
</style>
