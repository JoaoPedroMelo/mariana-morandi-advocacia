---
import SectionHead from './SectionHead.astro';
import Button from './Button.astro';
import { faq, faqIntro, faqCta } from '../data/faq';
import { whatsappUrl } from '../data/site';
---

<section class="section duvidas" id="duvidas" aria-labelledby="duvidas-title">
  <div class="container">
    <SectionHead id="duvidas-title" title="Dúvidas frequentes" lead={faqIntro} align="center" />

    <div class="duvidas__list">
      {
        faq.map((item) => (
          <details class="qa">
            <summary>
              <span class="qa__q">{item.question}</span>
              <span class="qa__sign" aria-hidden="true" />
            </summary>
            <div class="qa__a">
              {item.answer.map((paragraph) => (
                <p>{paragraph}</p>
              ))}
            </div>
          </details>
        ))
      }
    </div>

    <div class="duvidas__cta">
      <div>
        <p class="duvidas__cta-title">{faqCta.title}</p>
        <p class="duvidas__cta-text">{faqCta.text}</p>
      </div>
      <Button href={whatsappUrl()} external>Conversar pelo WhatsApp</Button>
    </div>
  </div>
</section>

<style>
  /* Título, lista e chamada centralizados no container, na mesma largura */
  .duvidas__list {
    max-width: 48rem;
    margin: var(--space-7) auto 0;
    border-top: var(--line) solid var(--rule-strong);
  }

  .qa {
    border-bottom: var(--line) solid var(--rule-strong);
  }

  .qa summary {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-5);
    padding-block: var(--space-5);
    cursor: pointer;
    list-style: none;
  }

  .qa summary::-webkit-details-marker {
    display: none;
  }

  .qa summary:focus-visible {
    outline-offset: 6px;
  }

  .qa__q {
    font-family: var(--font-display);
    font-size: var(--fs-lg);
    font-weight: 400;
    line-height: 1.35;
    color: var(--text);
  }

  .qa summary:hover .qa__q {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  /* "+" em traço fino, sem caixa; vira "−" ao abrir */
  .qa__sign {
    position: relative;
    flex: none;
    width: 1rem;
    height: 1rem;
    margin-top: 0.45em;
  }

  .qa__sign::before,
  .qa__sign::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: 1px;
    background: var(--petrol);
    transition: transform var(--dur) var(--ease);
  }

  .qa__sign::after {
    transform: rotate(90deg);
  }

  .qa[open] .qa__sign::after {
    transform: rotate(0deg);
  }

  .qa__a {
    display: grid;
    gap: var(--space-4);
    max-width: var(--measure);
    padding-bottom: var(--space-6);
    color: var(--text-muted);
  }

  /* Chamada final: mesmo card com borda esquerda da Atuação, na largura da lista */
  /* Mobile: card centralizado. A partir de 48em: texto à esquerda, botão à direita. */
  .duvidas__cta {
    display: grid;
    gap: var(--space-5);
    justify-items: center;
    text-align: center;
    max-width: 48rem;
    margin: var(--space-7) auto 0;
    padding: var(--space-6) var(--space-5);
    background: var(--ivory);
    border-left: 2px solid var(--petrol);
    border-radius: var(--radius);
  }

  .duvidas__cta-title {
    font-family: var(--font-display);
    font-size: var(--fs-lg);
    line-height: 1.3;
    color: var(--text);
  }

  .duvidas__cta-text {
    margin-top: var(--space-2);
    color: var(--text-muted);
  }

  @media (min-width: 48em) {
    .duvidas__cta {
      grid-template-columns: minmax(0, 1fr) auto;
      justify-items: start;
      align-items: center;
      text-align: left;
      gap: var(--space-6);
      padding: var(--space-6);
    }
  }
</style>
