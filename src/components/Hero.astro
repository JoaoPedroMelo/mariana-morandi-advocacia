---
import { Picture } from 'astro:assets';
import Button from './Button.astro';
import portrait from '../assets/photos/mariana-estudio.jpeg';
import { site, whatsappUrl } from '../data/site';
---

<section class="hero section--ivory" id="inicio" aria-labelledby="hero-title" data-hero>
  <div class="container hero__grid">
    <div class="hero__copy">
      <p class="eyebrow hero__eyebrow">{site.brand}</p>
      <h1 class="hero__title" id="hero-title">
        <span>Seus direitos</span> <span>previdenciários,</span> <span>com clareza e segurança.</span>
      </h1>
      <p class="hero__lead">
        Atendimento online e presencial em {site.location.label} para quem precisa entender seus direitos
        junto ao INSS: aposentadorias, benefícios por incapacidade, pensões, BPC/LOAS, revisões e recursos.
      </p>
      <div class="hero__actions">
        <Button href={whatsappUrl()} external>Conversar pelo WhatsApp</Button>
        <Button href="#atuacao" variant="outline">Conhecer a atuação</Button>
      </div>
    </div>

    <figure class="portrait">
      <div class="portrait__frame">
        <!-- Contorno do brasão, aberto no topo como na logo. Geometria em docs/ART_DIRECTION.md -->
        <svg class="portrait__outline" viewBox="-30 -30 880 1062" aria-hidden="true" focusable="false">
          <polyline points="-24,64 -24,831.5 410,1026.3 844,831.5 844,64"></polyline>
        </svg>
        <div class="portrait__clip">
          <Picture
            src={portrait}
            formats={['avif', 'webp']}
            widths={[360, 480, 640, 820, 1122]}
            sizes="(min-width: 64em) 28rem, (min-width: 40em) 20rem, 64vw"
            alt={`Retrato da advogada ${site.lawyer.name}, sorrindo, de óculos e blazer preto.`}
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </div>
      </div>
      <figcaption class="portrait__caption">
        <span>{site.lawyer.title} {site.lawyer.name}</span>
        <span class="eyebrow">{site.oab.label}</span>
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(2rem, 1rem + 5vw, 5.5rem) clamp(3.5rem, 2rem + 5vw, 6rem);
  }

  .hero__grid {
    display: grid;
    gap: var(--space-7);
    align-items: center;
  }

  .hero__eyebrow {
    margin-bottom: var(--space-5);
  }

  .hero__title {
    max-width: 13em;
    font-size: var(--fs-display);
    line-height: var(--lh-tight);
    letter-spacing: -0.025em;
  }

  .hero__lead {
    max-width: 34rem;
    margin-top: var(--space-6);
    font-size: var(--fs-md);
    color: var(--text-muted);
  }

  /* Mobile: botões empilhados na mesma largura. A partir de 40em: lado a lado. */
  .hero__actions {
    display: grid;
    gap: var(--space-3);
    width: min(100%, 22rem);
    margin-top: var(--space-7);
  }

  /* Retrato no perfil do brasão, com a identificação centrada sob a ponta.
     Mobile/tablet: aparece antes do título (só visualmente; no DOM o texto vem primeiro). */
  .portrait {
    order: -1;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .portrait__frame {
    position: relative;
    width: min(64vw, 18rem);
    aspect-ratio: 820 / 1000;
  }

  .portrait__clip {
    position: absolute;
    inset: 0;
    clip-path: polygon(0 0, 100% 0, 100% 81.6%, 50% 100%, 0 81.6%);
    background: #2a2e20;
  }

  .portrait__clip :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 28%;
  }

  .portrait__outline {
    position: absolute;
    left: -3.6585%;
    top: -3%;
    width: 107.317%;
    height: 106.2%;
    max-width: none;
    overflow: visible;
    pointer-events: none;
  }

  .portrait__outline polyline {
    fill: none;
    stroke: var(--sand);
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
    stroke-linejoin: miter;
  }

  /* Único momento de movimento da página: o contorno se revela de cima para baixo. */
  @media (prefers-reduced-motion: no-preference) {
    .portrait__outline {
      animation: outline-reveal 1400ms var(--ease) 250ms both;
    }

    @keyframes outline-reveal {
      from {
        clip-path: inset(0 0 100% 0);
      }
      to {
        clip-path: inset(0 0 0 0);
      }
    }
  }

  .portrait__caption {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-6);
    font-family: var(--font-display);
    font-size: var(--fs-md);
    line-height: 1.3;
    text-align: center;
    color: var(--text);
  }

  @media (min-width: 40em) {
    .hero__title span {
      display: block;
    }

    .hero__actions {
      display: flex;
      flex-wrap: wrap;
      width: auto;
    }

    .portrait__frame {
      width: 20rem;
    }
  }

  /* Desktop: o hero ocupa exatamente a área visível abaixo do header e cabe inteiro
     nela; retrato, título e espaçamentos acompanham a altura da tela. */
  @media (min-width: 64em) {
    .hero {
      --hero-pad: clamp(1.5rem, 5vh, 4rem);
      display: grid;
      align-items: center;
      min-height: calc(100vh - var(--header-h));
      padding-block: var(--hero-pad);
    }

    .hero__grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: var(--space-8);
    }

    /* "com clareza e segurança." (linha mais longa) mede ~10,1× o tamanho da fonte:
       o tamanho acompanha a coluna de 7/12 e, em telas baixas, a altura. */
    .hero__title {
      font-size: clamp(2.5rem, min(5.6vw - 0.5rem, 8vh), 3.625rem);
    }

    .hero__actions {
      margin-top: clamp(var(--space-5), 5vh, var(--space-7));
    }

    /* Largura limitada pela altura disponível: retrato (1,056× a altura da foto, com
       o contorno) + legenda (~6,5rem) cabem entre os respiros.
       O contorno ultrapassa a foto em 3,66% da largura de cada lado; a margem
       mantém o contorno dentro do container, alinhado ao botão do header. */
    .portrait {
      --portrait-w: min(100%, 28rem, (100vh - var(--header-h) - 2 * var(--hero-pad) - 6.5rem) * 0.77);
      order: 0;
      justify-self: end;
      width: var(--portrait-w);
      margin-right: calc(var(--portrait-w) * 0.0366);
    }

    .portrait__frame {
      width: 100%;
    }
  }
</style>
