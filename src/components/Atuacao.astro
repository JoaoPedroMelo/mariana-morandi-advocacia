---
import SectionHead from './SectionHead.astro';
import { practiceGroups, atuacaoIntro } from '../data/atuacao';
---

<section class="section section--ivory atuacao" id="atuacao" aria-labelledby="atuacao-title">
  <div class="container">
    <SectionHead
      id="atuacao-title"
      title="Áreas de atuação em Direito Previdenciário"
      lead={atuacaoIntro}
      layout="split"
    />

    <div class="atuacao__groups">
      {
        practiceGroups.map((group, index) => (
          <section class:list={['group', `group--${group.kind}`]} aria-labelledby={`grupo-${group.id}`}>
            <header class="group__head">
              <p class="eyebrow">
                {String(index + 1).padStart(2, '0')}
                <span class="group__label">{group.label}</span>
              </p>
              <h3 id={`grupo-${group.id}`}>{group.title}</h3>
              <p class="group__summary">{group.summary}</p>
            </header>
            <ul role="list" class="dot-list group__topics">
              {group.topics.map((topic) => (
                <li>
                  <h4>{topic.title}</h4>
                  <p>{topic.text}</p>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </div>
</section>

<style>
  .atuacao__groups {
    display: grid;
    gap: var(--space-5);
    margin-top: var(--space-8);
  }

  /* Card com borda esquerda */
  .group {
    display: grid;
    gap: var(--space-5);
    padding: var(--space-6) var(--space-5);
    background: var(--paper);
    border-left: 2px solid var(--petrol);
    border-radius: var(--radius);
  }

  /* Número e rótulo lado a lado: se o rótulo quebrar, a 2ª linha alinha com a 1ª */
  .group__head .eyebrow {
    display: flex;
    gap: var(--space-4);
  }

  .group__head h3 {
    margin-top: var(--space-3);
    font-size: var(--fs-xl);
    font-weight: 300;
    letter-spacing: -0.01em;
  }

  .group__summary {
    max-width: 30rem;
    margin-top: var(--space-3);
    font-size: var(--fs-sm);
    color: var(--text-muted);
  }

  .group__topics > li:last-child {
    border-bottom: 0;
  }

  .group__topics {
    --dot-line: calc(var(--fs-lg) * 1.3);
  }

  .group__topics > li:first-child {
    padding-top: 0;
  }

  .group__topics > li:first-child::before {
    top: calc(var(--dot-line) / 2 - 3px);
  }

  .group__topics h4 {
    font-size: var(--fs-lg);
    font-weight: 400;
    line-height: 1.3;
  }

  .group__topics p {
    max-width: 36rem;
    margin-top: var(--space-1);
    font-size: var(--fs-sm);
    color: var(--text-muted);
  }

  @media (min-width: 48em) {
    .group {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: var(--space-7);
      padding: var(--space-7) var(--space-6);
    }
  }
</style>
